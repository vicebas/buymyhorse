# Database
# Use either DATABASE_URL for a static password, or the RDS IAM settings below.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DB_AUTH_MODE=rds-iam
# RDSHOST=database-1-instance-1.cja4w2oo837g.us-east-2.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres

# Auth
NEXTAUTH_URL=https://your-domain.com
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS
AWS_REGION=us-east-1
AWS_PUBLIC_BUCKET_NAME=horseroster-public
AWS_PRIVATE_BUCKET_NAME=horseroster-private
NEXT_PUBLIC_PUBLIC_ASSET_BASE_URL=https://d1xxxxxxxxxx.cloudfront.net
AWS_PRIVATE_URL_EXPIRES_SECONDS=300
# Omit if using EC2 instance role
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# AI
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Email
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Media
HORSE_MEDIA_PROCESSOR_SECRET=<generate-with-openssl-rand-hex-32>
HORSE_VIDEO_MAX_UPLOAD_BYTES=78643200
HORSE_VIDEO_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm
FFMPEG_PATH=/usr/bin/ffmpeg

# Caddy / Docker Compose
APP_DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=ops@your-domain.com

# Optional defaults managed via admin panel if blank
STRIPE_PRICE_SINGLE_HORSE=
STRIPE_PRICE_BARN_STARTER=
STRIPE_PRICE_BARN_GROWTH=
STRIPE_PRICE_BARN_UNLIMITED=
STRIPE_PRICE_EXTRA_HORSE=
