// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum BarnPlan {
  ACTIVATION
}

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum BarnBillingStatus {
  TRIALING
  ACTIVE
  INCOMPLETE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum EquiTagAttachmentType {
  HORSE
  BARN
}

enum HorseMediaType {
  IMAGE
  VIDEO
}

enum AdminActionType {
  BARN_DISABLED
  BARN_RESTORED
  HORSE_DISABLED
  HORSE_RESTORED
  BILLING_OVERRIDE_SET
  BILLING_OVERRIDE_CLEARED
  BILLING_SETTINGS_UPDATED
  HORSE_SLOT_ADJUSTED
  USER_ROLE_CHANGED
}

enum AdminActionTargetType {
  BARN
  HORSE
  BILLING
  USER
}

enum HorseSlotLedgerSource {
  STRIPE_PURCHASE
  ADMIN_ADJUSTMENT
  MIGRATION_SEED
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique
  image String?

  password String?
  role     UserRole @default(BUYER)

  accounts Account[]
  sessions Session[]

  accessRequests AccessRequest[]     @relation("BuyerAccessRequests")
  accessGrants   AccessGrant[]       @relation("BuyerAccessGrants")
  conversations  HorseConversation[] @relation("HorseConversationBuyer")
  messages       HorseMessage[]
  uploadedHorseDocuments HorseDocument[]   @relation("UploadedHorseDocuments")
  vaultActivities        VaultActivityLog[] @relation("VaultActivityActor")
  adminDisabledBarns      SellerProfile[]   @relation("BarnAdminDisabledBy")
  adminBillingOverrides   SellerProfile[]   @relation("BarnBillingOverrideBy")
  adminDisabledHorses     Horse[]           @relation("HorseAdminDisabledBy")
  adminActionLogs         AdminActionLog[]  @relation("AdminActionActor")

  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique
  bio         String?
  location    String?
  website     String?
  logo        String?
  coverImage  String?
  headline    String?
  plan                BarnPlan          @default(ACTIVATION)
  billingCadence      BillingCadence    @default(MONTHLY)
  billingStatus       BarnBillingStatus @default(TRIALING)
  adminDisabledAt      DateTime?
  adminDisabledByUserId String?
  adminDisableReason   String?
  stripeCustomerId    String?           @unique
  stripeSubscriptionId String?          @unique
  stripePriceId       String?
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  canceledAt          DateTime?
  adminPlanOverride              BarnPlan?
  adminBillingCadenceOverride    BillingCadence?
  adminBillingStatusOverride     BarnBillingStatus?
  adminBillingOverrideReason     String?
  adminBillingOverrideExpiresAt  DateTime?
  adminBillingOverrideUpdatedAt  DateTime?
  adminBillingOverrideUpdatedByUserId String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminDisabledByUser User?              @relation("BarnAdminDisabledBy", fields: [adminDisabledByUserId], references: [id], onDelete: SetNull)
  adminBillingOverrideUpdatedByUser User? @relation("BarnBillingOverrideBy", fields: [adminBillingOverrideUpdatedByUserId], references: [id], onDelete: SetNull)
  horses             Horse[]
  accessGrantsGiven  AccessGrant[]
  horseConversations HorseConversation[]
  ownedEquiTags      EquiTag[]           @relation("OwnedEquiTags")
  attachedEquiTags   EquiTag[]           @relation("AttachedBarnEquiTags")
  horseSlotEntries   BarnHorseSlotLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HorseSaleStatus {
  FOR_SALE
  CONSIDERING_OFFERS
  SOLD
  LEASE
  NOT_AVAILABLE
}

enum DocumentCategory {
  XRAYS
  PPE
  VET_REPORTS
  CONTRACTS
  PASSPORT
  COMPETITION_RECORDS
  CARE
  OTHER
}

enum VaultActivityType {
  DOCUMENT_UPLOADED
  DOCUMENT_RENAMED
  DOCUMENT_MOVED
  DOCUMENT_SOFT_DELETED
  ACCESS_REQUEST_CREATED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  ACCESS_GRANT_REVOKED
}

model Horse {
  id              String   @id @default(cuid())
  sellerProfileId String

  name         String
  publicHorseId String? @unique
  nickname     String?
  breed        String?
  age          Int?
  gender       String?
  discipline   String?
  level        String?
  height       String?
  location     String?
  description  String?
  keyDetails   String?
  aiHighlights String?

  saleStatus  HorseSaleStatus @default(FOR_SALE)

  price       Decimal? @db.Decimal(12,2)
  image       String?
  isPublished Boolean @default(false)
  isBarnFeatured Boolean @default(false)
  barnDisplayOrder Int?
  isActive    Boolean @default(true)
  deletedAt   DateTime?
  adminDisabledAt      DateTime?
  adminDisabledByUserId String?
  adminDisableReason   String?

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  adminDisabledByUser User?    @relation("HorseAdminDisabledBy", fields: [adminDisabledByUserId], references: [id], onDelete: SetNull)

  documents        HorseDocument[]
  accessRequests   AccessRequest[]
  accessGrants     AccessGrant[]
  conversations    HorseConversation[]
  vaultActivities  VaultActivityLog[]
  attachedEquiTags EquiTag[]            @relation("AttachedHorseEquiTags")
  media            HorseMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HorseMedia {
  id            String        @id @default(cuid())
  horseId        String
  type          HorseMediaType
  originalPath  String
  processedPath String
  posterPath    String?
  mimeType      String?
  fileName      String
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, sortOrder])
}

model EquiTag {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  ownerSellerProfileId String
  attachedEntityType   EquiTagAttachmentType?
  attachedBarnId       String?
  attachedHorseId      String?
  svgPath              String
  pngPath              String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  ownerSellerProfile SellerProfile  @relation("OwnedEquiTags", fields: [ownerSellerProfileId], references: [id], onDelete: Cascade)
  attachedBarn      SellerProfile? @relation("AttachedBarnEquiTags", fields: [attachedBarnId], references: [id], onDelete: SetNull)
  attachedHorse     Horse?         @relation("AttachedHorseEquiTags", fields: [attachedHorseId], references: [id], onDelete: SetNull)
  visits            EquiTagVisit[]

  @@index([ownerSellerProfileId])
  @@index([attachedEntityType])
  @@index([attachedBarnId])
  @@index([attachedHorseId])
}

model EquiTagVisit {
  id                   String                  @id @default(cuid())
  equiTagId            String
  codeSnapshot         String
  ownerSellerProfileId String
  attachedEntityType   EquiTagAttachmentType?
  attachedBarnId       String?
  attachedHorseId      String?
  createdAt            DateTime                @default(now())

  equiTag EquiTag @relation(fields: [equiTagId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([equiTagId, createdAt])
  @@index([ownerSellerProfileId, createdAt])
}

model AdminActionLog {
  id         String                @id @default(cuid())
  actorUserId String
  actionType AdminActionType
  targetType AdminActionTargetType
  targetId   String
  reason     String?
  metadata   Json?
  createdAt  DateTime              @default(now())

  actor User @relation("AdminActionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model BillingSettings {
  id                       String   @id @default("default")
  activationTrialEnabled   Boolean  @default(false)
  activationTrialDays      Int      @default(7)
  activationMonthlyPriceId String?
  activationYearlyPriceId  String?
  extraHorsePriceId        String?
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model BarnHorseSlotLedger {
  id                    String                @id @default(cuid())
  sellerProfileId       String
  quantity              Int
  source                HorseSlotLedgerSource
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId String?
  adminUserId           String?
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId, createdAt])
  @@index([source, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

model HorseDocument {
  id               String   @id @default(cuid())
  horseId          String
  title            String
  filePath         String
  fileName         String
  mimeType         String?
  isPrivate        Boolean  @default(true)
  category         DocumentCategory @default(OTHER)
  fileSizeBytes    Int?
  uploadedByUserId String
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  horse           Horse                 @relation(fields: [horseId], references: [id], onDelete: Cascade)
  uploadedBy      User                  @relation("UploadedHorseDocuments", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  grantedIn       AccessGrantFile[]
  vaultActivities VaultActivityLog[]

  @@index([horseId, deletedAt])
  @@index([category])
}

model AccessRequest {
  id           String              @id @default(cuid())
  horseId      String
  buyerId      String
  message      String?
  status       AccessRequestStatus @default(PENDING)
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer User  @relation("BuyerAccessRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  vaultActivities     VaultActivityLog[]

  @@index([horseId, buyerId])
  @@index([status])
}

model AccessGrant {
  id                String    @id @default(cuid())
  horseId           String
  buyerId           String
  grantedBySellerId String
  expiresAt         DateTime?
  revokedAt         DateTime?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  horse           Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer           User          @relation("BuyerAccessGrants", fields: [buyerId], references: [id], onDelete: Cascade)
  grantedBySeller SellerProfile @relation(fields: [grantedBySellerId], references: [id], onDelete: Cascade)
  grantedFiles      AccessGrantFile[]
  vaultActivities   VaultActivityLog[]
  messages          HorseMessage[]

  @@unique([horseId, buyerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AccessGrantFile {
  id              String   @id @default(cuid())
  accessGrantId   String
  horseDocumentId String
  createdAt       DateTime @default(now())

  accessGrant  AccessGrant  @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument @relation(fields: [horseDocumentId], references: [id], onDelete: Cascade)

  @@unique([accessGrantId, horseDocumentId])
}

enum HorseMessageType {
  TEXT
  GRANT
}

model VaultActivityLog {
  id             String            @id @default(cuid())
  horseId         String
  horseDocumentId String?
  accessRequestId String?
  accessGrantId   String?
  actorUserId     String
  activityType    VaultActivityType
  metadata        Json?
  createdAt       DateTime @default(now())

  horse         Horse          @relation(fields: [horseId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument? @relation(fields: [horseDocumentId], references: [id], onDelete: SetNull)
  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  accessGrant   AccessGrant?   @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
  actorUser     User           @relation("VaultActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([horseId, createdAt])
  @@index([activityType, createdAt])
}

model HorseConversation {
  id        String   @id @default(cuid())
  horseId   String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())

  horse         Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer         User          @relation("HorseConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  messages HorseMessage[]

  @@unique([horseId, buyerId])
}

model HorseMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String?
  messageType    HorseMessageType @default(TEXT)
  accessGrantId  String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation HorseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderUserId], references: [id])
  accessGrant  AccessGrant?      @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
}
