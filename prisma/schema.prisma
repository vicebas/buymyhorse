// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique
  image String?

  password String?
  role     UserRole @default(BUYER)

  accounts Account[]
  sessions Session[]

  accessRequests AccessRequest[]     @relation("BuyerAccessRequests")
  accessGrants   AccessGrant[]       @relation("BuyerAccessGrants")
  conversations  HorseConversation[] @relation("HorseConversationBuyer")
  messages       HorseMessage[]

  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique
  bio         String?
  location    String?
  website     String?
  logo        String?
  headline    String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  horses             Horse[]
  accessGrantsGiven  AccessGrant[]
  horseConversations HorseConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Horse {
  id              String @id @default(cuid())
  sellerProfileId String

  name        String
  breed       String?
  age         Int?
  gender      String?
  discipline  String?
  description String?
  price       Decimal? @db.Decimal(12, 2)

  image       String?
  isPublished Boolean @default(false)

  sellerProfile  SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  documents      HorseDocument[]
  accessRequests AccessRequest[]
  accessGrants   AccessGrant[]
  conversations  HorseConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model HorseDocument {
  id        String   @id @default(cuid())
  horseId   String
  title     String
  filePath  String
  fileName  String
  mimeType  String?
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
}

model AccessRequest {
  id        String              @id @default(cuid())
  horseId   String
  buyerId   String
  message   String?
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer User  @relation("BuyerAccessRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([horseId, buyerId])
}

model AccessGrant {
  id                String    @id @default(cuid())
  horseId           String
  buyerId           String
  grantedBySellerId String
  expiresAt         DateTime?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  horse           Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer           User          @relation("BuyerAccessGrants", fields: [buyerId], references: [id], onDelete: Cascade)
  grantedBySeller SellerProfile @relation(fields: [grantedBySellerId], references: [id], onDelete: Cascade)

  @@unique([horseId, buyerId])
}

model HorseConversation {
  id        String   @id @default(cuid())
  horseId   String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())

  horse         Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer         User          @relation("HorseConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  messages HorseMessage[]

  @@unique([horseId, buyerId])
}

model HorseMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation HorseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderUserId], references: [id])
}
