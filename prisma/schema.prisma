// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique
  image String?

  password String?
  role     UserRole @default(BUYER)

  accounts Account[]
  sessions Session[]

  accessRequests AccessRequest[]     @relation("BuyerAccessRequests")
  accessGrants   AccessGrant[]       @relation("BuyerAccessGrants")
  conversations  HorseConversation[] @relation("HorseConversationBuyer")
  messages       HorseMessage[]
  uploadedHorseDocuments HorseDocument[]   @relation("UploadedHorseDocuments")
  vaultActivities        VaultActivityLog[] @relation("VaultActivityActor")

  sellerProfile SellerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  slug        String   @unique
  bio         String?
  location    String?
  website     String?
  logo        String?
  headline    String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  horses             Horse[]
  accessGrantsGiven  AccessGrant[]
  horseConversations HorseConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum HorseSaleStatus {
  FOR_SALE
  CONSIDERING_OFFERS
  SOLD
  LEASE
  NOT_AVAILABLE
}

enum DocumentCategory {
  XRAYS
  PPE
  VET_REPORTS
  CONTRACTS
  PASSPORT
  COMPETITION_RECORDS
  CARE
  OTHER
}

enum VaultActivityType {
  DOCUMENT_UPLOADED
  DOCUMENT_RENAMED
  DOCUMENT_MOVED
  DOCUMENT_SOFT_DELETED
  ACCESS_REQUEST_CREATED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  ACCESS_GRANT_REVOKED
}

model Horse {
  id              String   @id @default(cuid())
  sellerProfileId String

  name         String
  publicHorseId String? @unique
  nickname     String?
  breed        String?
  age          Int?
  gender       String?
  discipline   String?
  level        String?
  height       String?
  location     String?
  description  String?
  keyDetails   String?
  aiHighlights String?

  saleStatus  HorseSaleStatus @default(FOR_SALE)

  price       Decimal? @db.Decimal(12,2)
  image       String?
  isPublished Boolean @default(false)
  isActive    Boolean @default(true)
  deletedAt   DateTime?

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  documents       HorseDocument[]
  accessRequests  AccessRequest[]
  accessGrants    AccessGrant[]
  conversations   HorseConversation[]
  vaultActivities VaultActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

model HorseDocument {
  id               String   @id @default(cuid())
  horseId          String
  title            String
  filePath         String
  fileName         String
  mimeType         String?
  isPrivate        Boolean  @default(true)
  category         DocumentCategory @default(OTHER)
  fileSizeBytes    Int?
  uploadedByUserId String
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  horse           Horse                 @relation(fields: [horseId], references: [id], onDelete: Cascade)
  uploadedBy      User                  @relation("UploadedHorseDocuments", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  requestedIn     AccessRequestFile[]
  grantedIn       AccessGrantFile[]
  vaultActivities VaultActivityLog[]

  @@index([horseId, deletedAt])
  @@index([category])
}

model AccessRequest {
  id           String              @id @default(cuid())
  horseId      String
  buyerId      String
  message      String?
  status       AccessRequestStatus @default(PENDING)
  intendedUse  String?
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer User  @relation("BuyerAccessRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  requestedCategories AccessRequestCategory[]
  requestedFiles      AccessRequestFile[]
  vaultActivities     VaultActivityLog[]

  @@index([horseId, buyerId])
  @@index([status])
}

model AccessGrant {
  id                String    @id @default(cuid())
  horseId           String
  buyerId           String
  grantedBySellerId String
  expiresAt         DateTime?
  revokedAt         DateTime?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  horse           Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer           User          @relation("BuyerAccessGrants", fields: [buyerId], references: [id], onDelete: Cascade)
  grantedBySeller SellerProfile @relation(fields: [grantedBySellerId], references: [id], onDelete: Cascade)
  grantedCategories AccessGrantCategory[]
  grantedFiles      AccessGrantFile[]
  vaultActivities   VaultActivityLog[]

  @@unique([horseId, buyerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AccessRequestCategory {
  id              String           @id @default(cuid())
  accessRequestId String
  category        DocumentCategory
  createdAt       DateTime @default(now())

  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@unique([accessRequestId, category])
  @@index([category])
}

model AccessRequestFile {
  id              String   @id @default(cuid())
  accessRequestId String
  horseDocumentId String
  createdAt       DateTime @default(now())

  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  horseDocument  HorseDocument @relation(fields: [horseDocumentId], references: [id], onDelete: Cascade)

  @@unique([accessRequestId, horseDocumentId])
}

model AccessGrantCategory {
  id            String           @id @default(cuid())
  accessGrantId String
  category      DocumentCategory
  createdAt     DateTime @default(now())

  accessGrant AccessGrant @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)

  @@unique([accessGrantId, category])
  @@index([category])
}

model AccessGrantFile {
  id              String   @id @default(cuid())
  accessGrantId   String
  horseDocumentId String
  createdAt       DateTime @default(now())

  accessGrant  AccessGrant  @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument @relation(fields: [horseDocumentId], references: [id], onDelete: Cascade)

  @@unique([accessGrantId, horseDocumentId])
}

model VaultActivityLog {
  id             String            @id @default(cuid())
  horseId         String
  horseDocumentId String?
  accessRequestId String?
  accessGrantId   String?
  actorUserId     String
  activityType    VaultActivityType
  metadata        Json?
  createdAt       DateTime @default(now())

  horse         Horse          @relation(fields: [horseId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument? @relation(fields: [horseDocumentId], references: [id], onDelete: SetNull)
  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  accessGrant   AccessGrant?   @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
  actorUser     User           @relation("VaultActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([horseId, createdAt])
  @@index([activityType, createdAt])
}

model HorseConversation {
  id        String   @id @default(cuid())
  horseId   String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())

  horse         Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer         User          @relation("HorseConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  messages HorseMessage[]

  @@unique([horseId, buyerId])
}

model HorseMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  createdAt      DateTime @default(now())

  conversation HorseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderUserId], references: [id])
}
