// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum BarnPlan {
  ACTIVATION
}

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum BarnBillingStatus {
  TRIALING
  ACTIVE
  INCOMPLETE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum EquiTagAttachmentType {
  HORSE
  BARN
}

enum HorseMediaType {
  IMAGE
  VIDEO
}

enum HorseMediaProcessingStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum AdminActionType {
  BARN_DISABLED
  BARN_RESTORED
  HORSE_DISABLED
  HORSE_RESTORED
  HORSE_PLATFORM_FEATURED
  HORSE_PLATFORM_UNFEATURED
  BILLING_OVERRIDE_SET
  BILLING_OVERRIDE_CLEARED
  BILLING_SETTINGS_UPDATED
  HORSE_SLOT_ADJUSTED
  USER_ROLE_CHANGED
  ADMIN_GRANT_REVOKED
  LISTING_OPTIONS_UPDATED
}

enum AdminActionTargetType {
  BARN
  HORSE
  BILLING
  USER
  ACCESS_GRANT
  LISTING_OPTION
}

enum HorseSlotLedgerSource {
  STRIPE_PURCHASE
  ADMIN_ADJUSTMENT
  MIGRATION_SEED
}

enum EquiTagOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductEventType {
  SIGNUP
  LOGIN
  HORSE_CREATION
  HORSE_EDIT
  DOCUMENT_UPLOAD
  GALLERY_UPLOAD
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique
  image String?

  password      String?
  role          UserRole  @default(BUYER)
  emailVerified DateTime?

  accounts Account[]
  sessions Session[]

  accessRequests         AccessRequest[]     @relation("BuyerAccessRequests")
  accessGrants           AccessGrant[]       @relation("BuyerAccessGrants")
  conversations          HorseConversation[] @relation("HorseConversationBuyer")
  messages               HorseMessage[]
  uploadedHorseDocuments HorseDocument[]     @relation("UploadedHorseDocuments")
  vaultActivities        VaultActivityLog[]  @relation("VaultActivityActor")
  adminDisabledBarns     SellerProfile[]     @relation("BarnAdminDisabledBy")
  adminBillingOverrides  SellerProfile[]     @relation("BarnBillingOverrideBy")
  adminDisabledHorses    Horse[]             @relation("HorseAdminDisabledBy")
  adminActionLogs        AdminActionLog[]    @relation("AdminActionActor")
  productEvents          ProductEvent[]      @relation("ProductEventActor")

  sellerProfile SellerProfile?

  sellerContactTargets    SellerContactControl[]   @relation("SellerContactTargets")
  savedHorses             SavedHorse[]
  barnFollows             BarnFollow[]
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  passwordResetTokens     PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id                                  String             @id @default(cuid())
  userId                              String             @unique
  displayName                         String
  slug                                String             @unique
  bio                                 String?
  location                            String?
  website                             String?
  logo                                String?
  coverImage                          String?
  headline                            String?
  phone                               String?
  primaryNotificationEmail            String?
  plan                                BarnPlan           @default(ACTIVATION)
  billingCadence                      BillingCadence     @default(MONTHLY)
  billingStatus                       BarnBillingStatus  @default(TRIALING)
  adminDisabledAt                     DateTime?
  adminDisabledByUserId               String?
  adminDisableReason                  String?
  stripeCustomerId                    String?            @unique
  stripeSubscriptionId                String?            @unique
  stripePriceId                       String?
  trialEndsAt                         DateTime?
  currentPeriodEndsAt                 DateTime?
  canceledAt                          DateTime?
  adminPlanOverride                   BarnPlan?
  adminBillingCadenceOverride         BillingCadence?
  adminBillingStatusOverride          BarnBillingStatus?
  adminBillingOverrideReason          String?
  adminBillingOverrideExpiresAt       DateTime?
  adminBillingOverrideUpdatedAt       DateTime?
  adminBillingOverrideUpdatedByUserId String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminDisabledByUser User?              @relation("BarnAdminDisabledBy", fields: [adminDisabledByUserId], references: [id], onDelete: SetNull)
  adminBillingOverrideUpdatedByUser User? @relation("BarnBillingOverrideBy", fields: [adminBillingOverrideUpdatedByUserId], references: [id], onDelete: SetNull)
  horses             Horse[]
  followers          BarnFollow[]
  accessGrantsGiven  AccessGrant[]
  horseConversations HorseConversation[]
  ownedEquiTags      EquiTag[]           @relation("OwnedEquiTags")
  attachedEquiTags   EquiTag[]           @relation("AttachedBarnEquiTags")
  horseSlotEntries   BarnHorseSlotLedger[]
  sellerContactControls SellerContactControl[] @relation("SellerProfileContactControls")
  equiTagOrders      EquiTagOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerContactControl {
  id              String   @id @default(cuid())
  sellerProfileId String
  targetUserId    String
  isMuted         Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sellerProfile SellerProfile @relation("SellerProfileContactControls", fields: [sellerProfileId], references: [id], onDelete: Cascade)
  targetUser    User          @relation("SellerContactTargets", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, targetUserId])
  @@index([sellerProfileId])
  @@index([targetUserId])
}

enum HorseSaleStatus {
  FOR_SALE
  CONSIDERING_OFFERS
  SOLD
  LEASE
  NOT_AVAILABLE
}

enum HorseDivisionContext {
  BEST_SUITED_FOR
  CURRENTLY_COMPETING_IN
  EXPERIENCED_THROUGH
  SCHOOLING_THROUGH
}

enum DocumentCategory {
  XRAYS
  PPE
  VET_REPORTS
  CONTRACTS
  PASSPORT
  COMPETITION_RECORDS
  CARE
  OTHER
}

enum VaultActivityType {
  DOCUMENT_UPLOADED
  DOCUMENT_RENAMED
  DOCUMENT_MOVED
  DOCUMENT_SOFT_DELETED
  ACCESS_REQUEST_CREATED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  ACCESS_GRANT_REVOKED
}

model Horse {
  id              String @id @default(cuid())
  sellerProfileId String

  name                      String
  publicHorseId             String? @unique
  nickname                  String?
  breed                     String?
  age                       Int?
  gender                    String?
  discipline                String?
  level                     String?
  height                    String?
  location                  String?
  description               String?
  keyDetails                String?
  aiHighlights              String?
  breedOptionId             String?
  sexOptionId               String?
  primaryDisciplineId       String?
  pricingVisibilityOptionId String?
  saleTypeOptionId          String?
  colorOptionId             String?
  importStatusOptionId      String?
  feiPassport               Boolean @default(false)
  equiVaultAvailable        Boolean @default(false)
  registrationStatus        String?
  showHighlights            String?

  saleStatus HorseSaleStatus @default(FOR_SALE)

  price                 Decimal?  @db.Decimal(12, 2)
  image                 String?
  isPublished           Boolean   @default(false)
  isBarnFeatured        Boolean   @default(false)
  isPlatformFeatured    Boolean   @default(false)
  platformFeaturedAt    DateTime?
  barnDisplayOrder      Int?
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  adminDisabledAt       DateTime?
  adminDisabledByUserId String?
  adminDisableReason    String?

  sellerProfile           SellerProfile            @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  adminDisabledByUser     User?                    @relation("HorseAdminDisabledBy", fields: [adminDisabledByUserId], references: [id], onDelete: SetNull)
  breedOption             BreedOption?             @relation(fields: [breedOptionId], references: [id], onDelete: SetNull)
  sexOption               SexOption?               @relation(fields: [sexOptionId], references: [id], onDelete: SetNull)
  primaryDiscipline       DisciplineOption?        @relation("HorsePrimaryDiscipline", fields: [primaryDisciplineId], references: [id], onDelete: SetNull)
  pricingVisibilityOption PricingVisibilityOption? @relation(fields: [pricingVisibilityOptionId], references: [id], onDelete: SetNull)
  saleTypeOption          SaleTypeOption?          @relation(fields: [saleTypeOptionId], references: [id], onDelete: SetNull)
  colorOption             ColorOption?             @relation(fields: [colorOptionId], references: [id], onDelete: SetNull)
  importStatusOption      ImportStatusOption?      @relation(fields: [importStatusOptionId], references: [id], onDelete: SetNull)

  documents            HorseDocument[]
  accessRequests       AccessRequest[]
  accessGrants         AccessGrant[]
  conversations        HorseConversation[]
  vaultActivities      VaultActivityLog[]
  attachedEquiTags     EquiTag[]                  @relation("AttachedHorseEquiTags")
  media                HorseMedia[]
  savedByUsers         SavedHorse[]
  featureMetrics       HorseFeatureMetrics?
  secondaryDisciplines HorseSecondaryDiscipline[]
  divisionTags         HorseDivisionTag[]
  idealRiders          HorseIdealRider[]
  horseTypes           HorseTypeSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPlatformFeatured, platformFeaturedAt])
  @@index([breedOptionId])
  @@index([sexOptionId])
  @@index([primaryDisciplineId])
  @@index([pricingVisibilityOptionId])
  @@index([saleTypeOptionId])
  @@index([colorOptionId])
  @@index([importStatusOptionId])
}

model HorseFeatureMetrics {
  horseId              String   @id
  profileViews         Int      @default(0)
  clickThroughs        Int      @default(0)
  lastProfileViewAt    DateTime?
  lastClickThroughAt   DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
}

model DisciplineOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryForHorses   Horse[]                    @relation("HorsePrimaryDiscipline")
  secondaryForHorses HorseSecondaryDiscipline[]
  divisionOptions    DivisionOption[]
}

model DivisionOption {
  id           String   @id @default(cuid())
  disciplineId String
  label        String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discipline DisciplineOption   @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  horseTags  HorseDivisionTag[]

  @@unique([disciplineId, label])
  @@index([disciplineId, sortOrder])
}

model IdealRiderOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses HorseIdealRider[]
}

model HorseTypeOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses HorseTypeSelection[]
}

model PricingVisibilityOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model SaleTypeOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model BreedOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model SexOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model ColorOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model ImportStatusOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  horses Horse[]
}

model HorseSecondaryDiscipline {
  id           String   @id @default(cuid())
  horseId      String
  disciplineId String
  createdAt    DateTime @default(now())

  horse      Horse            @relation(fields: [horseId], references: [id], onDelete: Cascade)
  discipline DisciplineOption @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([horseId, disciplineId])
  @@index([disciplineId])
}

model HorseDivisionTag {
  id               String               @id @default(cuid())
  horseId          String
  divisionOptionId String
  context          HorseDivisionContext
  createdAt        DateTime             @default(now())

  horse          Horse          @relation(fields: [horseId], references: [id], onDelete: Cascade)
  divisionOption DivisionOption @relation(fields: [divisionOptionId], references: [id], onDelete: Cascade)

  @@unique([horseId, divisionOptionId, context])
  @@index([divisionOptionId, context])
}

model HorseIdealRider {
  id                 String   @id @default(cuid())
  horseId            String
  idealRiderOptionId String
  createdAt          DateTime @default(now())

  horse            Horse            @relation(fields: [horseId], references: [id], onDelete: Cascade)
  idealRiderOption IdealRiderOption @relation(fields: [idealRiderOptionId], references: [id], onDelete: Cascade)

  @@unique([horseId, idealRiderOptionId])
  @@index([idealRiderOptionId])
}

model HorseTypeSelection {
  id                String   @id @default(cuid())
  horseId           String
  horseTypeOptionId String
  createdAt         DateTime @default(now())

  horse           Horse           @relation(fields: [horseId], references: [id], onDelete: Cascade)
  horseTypeOption HorseTypeOption @relation(fields: [horseTypeOptionId], references: [id], onDelete: Cascade)

  @@unique([horseId, horseTypeOptionId])
  @@index([horseTypeOptionId])
}

model HorseMedia {
  id            String                     @id @default(cuid())
  horseId       String
  type          HorseMediaType
  status        HorseMediaProcessingStatus @default(READY)
  originalPath  String
  processedPath String?
  posterPath    String?
  mimeType      String?
  fileName      String
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId, sortOrder])
}

model EquiTag {
  id                   String                 @id @default(cuid())
  code                 String                 @unique
  ownerSellerProfileId String
  attachedEntityType   EquiTagAttachmentType?
  attachedBarnId       String?
  attachedHorseId      String?
  svgPath              String
  pngPath              String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  ownerSellerProfile SellerProfile  @relation("OwnedEquiTags", fields: [ownerSellerProfileId], references: [id], onDelete: Cascade)
  attachedBarn      SellerProfile? @relation("AttachedBarnEquiTags", fields: [attachedBarnId], references: [id], onDelete: SetNull)
  attachedHorse     Horse?         @relation("AttachedHorseEquiTags", fields: [attachedHorseId], references: [id], onDelete: SetNull)
  visits            EquiTagVisit[]
  orders            EquiTagOrder[]

  @@index([ownerSellerProfileId])
  @@index([attachedEntityType])
  @@index([attachedBarnId])
  @@index([attachedHorseId])
}

model EquiTagVisit {
  id                   String                 @id @default(cuid())
  equiTagId            String
  codeSnapshot         String
  ownerSellerProfileId String
  attachedEntityType   EquiTagAttachmentType?
  attachedBarnId       String?
  attachedHorseId      String?
  createdAt            DateTime               @default(now())

  equiTag EquiTag @relation(fields: [equiTagId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([equiTagId, createdAt])
  @@index([ownerSellerProfileId, createdAt])
}

model AdminActionLog {
  id          String                @id @default(cuid())
  actorUserId String
  actionType  AdminActionType
  targetType  AdminActionTargetType
  targetId    String
  reason      String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  actor User @relation("AdminActionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model BillingSettings {
  id                       String   @id @default("default")
  activationTrialEnabled   Boolean  @default(false)
  activationTrialDays      Int      @default(7)
  activationMonthlyPriceId String?
  activationYearlyPriceId  String?
  extraHorsePriceId        String?
  equitagPhysicalPriceId   String?
  equitagMaxBatchQuantity  Int      @default(10)
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model BarnHorseSlotLedger {
  id                      String                @id @default(cuid())
  sellerProfileId         String
  quantity                Int
  source                  HorseSlotLedgerSource
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?
  adminUserId             String?
  note                    String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId, createdAt])
  @@index([source, createdAt])
}

model EquiTagOrder {
  id                      String             @id @default(cuid())
  sellerProfileId         String
  equiTagId               String
  quantity                Int                @default(1)
  status                  EquiTagOrderStatus @default(PENDING_PAYMENT)
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?
  canceledBySellerAt      DateTime?
  canceledByAdminAt       DateTime?
  deliveryCompany         String?
  trackingCode            String?
  estimatedDeliveryDate   DateTime?
  shippingName            String?
  shippingAddressLine1    String?
  shippingAddressLine2    String?
  shippingCity            String?
  shippingState           String?
  shippingPostalCode      String?
  shippingCountry         String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  equiTag       EquiTag       @relation(fields: [equiTagId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId, createdAt])
  @@index([status, createdAt])
}

model SavedHorse {
  id        String   @id @default(cuid())
  userId    String
  horseId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([userId, horseId])
  @@index([userId])
  @@index([horseId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

model HorseDocument {
  id               String           @id @default(cuid())
  horseId          String
  title            String
  filePath         String
  fileName         String
  mimeType         String?
  isPrivate        Boolean          @default(true)
  category         DocumentCategory @default(OTHER)
  fileSizeBytes    Int?
  uploadedByUserId String
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  horse           Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  uploadedBy      User               @relation("UploadedHorseDocuments", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  grantedIn       AccessGrantFile[]
  vaultActivities VaultActivityLog[]

  @@index([horseId, deletedAt])
  @@index([category])
}

model AccessRequest {
  id           String              @id @default(cuid())
  horseId      String
  buyerId      String
  intendedUse  String?
  message      String?
  status       AccessRequestStatus @default(PENDING)
  decisionNote String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer User  @relation("BuyerAccessRequests", fields: [buyerId], references: [id], onDelete: Cascade)

  requestedCategories AccessRequestCategory[]
  vaultActivities     VaultActivityLog[]

  @@index([horseId, buyerId])
  @@index([status])
}

model AccessRequestCategory {
  id              String           @id @default(cuid())
  accessRequestId String
  category        DocumentCategory
  createdAt       DateTime         @default(now())

  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@unique([accessRequestId, category])
  @@index([category])
}

model AccessGrant {
  id                String    @id @default(cuid())
  horseId           String
  buyerId           String
  grantedBySellerId String
  expiresAt         DateTime?
  revokedAt         DateTime?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  horse           Horse              @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer           User               @relation("BuyerAccessGrants", fields: [buyerId], references: [id], onDelete: Cascade)
  grantedBySeller SellerProfile      @relation(fields: [grantedBySellerId], references: [id], onDelete: Cascade)
  grantedFiles    AccessGrantFile[]
  vaultActivities VaultActivityLog[]
  messages        HorseMessage[]

  @@unique([horseId, buyerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AccessGrantFile {
  id              String   @id @default(cuid())
  accessGrantId   String
  horseDocumentId String
  createdAt       DateTime @default(now())

  accessGrant   AccessGrant   @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument @relation(fields: [horseDocumentId], references: [id], onDelete: Cascade)

  @@unique([accessGrantId, horseDocumentId])
}

enum HorseMessageType {
  TEXT
  GRANT
}

model VaultActivityLog {
  id              String            @id @default(cuid())
  horseId         String
  horseDocumentId String?
  accessRequestId String?
  accessGrantId   String?
  actorUserId     String
  activityType    VaultActivityType
  metadata        Json?
  createdAt       DateTime          @default(now())

  horse         Horse          @relation(fields: [horseId], references: [id], onDelete: Cascade)
  horseDocument HorseDocument? @relation(fields: [horseDocumentId], references: [id], onDelete: SetNull)
  accessRequest AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  accessGrant   AccessGrant?   @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
  actorUser     User           @relation("VaultActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([horseId, createdAt])
  @@index([activityType, createdAt])
}

model HorseConversation {
  id               String    @id @default(cuid())
  horseId          String
  buyerId          String
  sellerId         String
  sellerLastReadAt DateTime?
  buyerLastReadAt  DateTime?
  createdAt        DateTime  @default(now())

  horse         Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  buyer         User          @relation("HorseConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  messages HorseMessage[]

  @@unique([horseId, buyerId])
}

model HorseMessage {
  id             String           @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String?
  messageType    HorseMessageType @default(TEXT)
  accessGrantId  String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation HorseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderUserId], references: [id])
  accessGrant  AccessGrant?      @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
}

enum NotificationType {
  NEW_HORSE_FROM_FOLLOWED_BARN
  HORSE_UPDATED_FROM_FOLLOWED_BARN
  NEW_MESSAGE
}

model BarnFollow {
  id              String   @id @default(cuid())
  userId          String
  sellerProfileId String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, sellerProfileId])
  @@index([userId])
  @@index([sellerProfileId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ProductEvent {
  id              String           @id @default(cuid())
  actorUserId     String
  eventType       ProductEventType
  horseId         String?
  horseDocumentId String?
  horseMediaId    String?
  metadata        Json?
  createdAt       DateTime         @default(now())

  actorUser User @relation("ProductEventActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([horseId, createdAt])
  @@index([horseDocumentId, createdAt])
  @@index([horseMediaId, createdAt])
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique

  systemNewHorseFromFollowedBarn     Boolean @default(true)
  systemHorseUpdatedFromFollowedBarn Boolean @default(true)
  systemNewMessage                   Boolean @default(true)

  emailNewHorseFromFollowedBarn     Boolean @default(true)
  emailHorseUpdatedFromFollowedBarn Boolean @default(false)
  emailNewMessage                   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
